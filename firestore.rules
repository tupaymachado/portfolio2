rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Usuários precisam estar autenticados para qualquer operação
    function isAuth() {
      return request.auth != null;
    }

    // Perfis de usuário
    // Leitura aberta para autenticados (necessário para lista de participantes e busca por email)
    // Escrita restrita ao próprio usuário
    match /users/{uid} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == uid;

      // Lista de contatos: apenas o dono pode ler e escrever
      match /contacts/{contactUid} {
        allow read, write: if isAuth() && request.auth.uid == uid;
      }
    }
  }
}
